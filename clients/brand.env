# 两端 App 共用的品牌与服务器配置。改完重新运行各端的 prepare 脚本。
# 现在是临时值，内测前换成正式的名字、包名、域名和颜色。

# App 显示名称
APP_NAME=Chat
# 服务器域名（与 deploy/.env 的 DOMAIN 一致）
DOMAIN=chat.test
# 安卓包名 / iOS Bundle ID 前缀，定了就别改（改了等于新 App）
APP_ID=com.example.chat
# 主色（ARGB 十六进制）
BRAND_COLOR=FF2F6BFF
# iOS 开发者团队 ID（超级签账号的 Team ID）。只在模拟器里跑可以先留空
IOS_TEAM_ID=
